{
  "functions": {
    "api/translate.js": {
      "maxDuration": 60
    },
    "api/appeal.js": {
      "maxDuration": 60
    },
    "api/fightpack.js": {
      "maxDuration": 120
    },
    "api/unlock.js": {
      "maxDuration": 30
    },
    "api/email-kit.js": {
      "maxDuration": 30
    },
    "api/app-checkin.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fightpack",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/translate",
      "destination": "/translate.html"
    },
    {
      "source": "/appeal",
      "destination": "/appeal.html"
    },
    {
      "source": "/denials",
      "destination": "/denials.html"
    },
    {
      "source": "/denials/medical-necessity",
      "destination": "/denials-medical-necessity.html"
    },
    {
      "source": "/denials/prior-auth",
      "destination": "/denials-prior-auth.html"
    },
    {
      "source": "/denials/out-of-network",
      "destination": "/denials-out-of-network.html"
    },
    {
      "source": "/denials/not-covered",
      "destination": "/denials-not-covered.html"
    },
    {
      "source": "/denials/experimental",
      "destination": "/denials-experimental.html"
    },
    {
      "source": "/denials/missing-info",
      "destination": "/denials-missing-info.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/how-its-tested",
      "destination": "/how-its-tested.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/codes",
      "destination": "/api/codelibrary"
    },
    {
      "source": "/codes/",
      "destination": "/api/codelibrary"
    },
    {
      "source": "/codes/:slug",
      "destination": "/api/codepage?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
